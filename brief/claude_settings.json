{
  "statusLine": {
    "type": "command",
    "command": "node brief/tools/cc_statusline_snapshot.mjs",
    "refreshInterval": 60
  },
  "permissions": {
    "allow": [
      "Bash(node brief/tools/*)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(npx supabase start*)",
      "Bash(npx supabase stop*)",
      "Bash(npx supabase status*)",
      "Bash(npx supabase test db*)",
      "Bash(npx supabase db lint*)",
      "Bash(npx supabase db advisors*)",
      "Bash(npx supabase db reset)",
      "Bash(npx supabase migration new*)",
      "Bash(docker ps*)",
      "Bash(git --no-optional-locks status*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git stash *)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D*)",
      "Bash(git config *)",
      "Bash(npx supabase db push*)",
      "Bash(npx supabase link*)",
      "Bash(npx supabase secrets*)",
      "Bash(npx supabase functions*)",
      "Bash(npx supabase db reset --linked*)",
      "Bash(npx supabase projects*)",
      "Bash(supabase *)",
      "Read(**/dart_define.local.json)",
      "Read(**/key.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(brief/.runtime/**)",
      "Edit(brief/00_MASTER_PROMPT.md)",
      "Edit(brief/04_BUDGET_PROTOCOL.md)",
      "Edit(brief/tools/budget_check.mjs)",
      "Edit(brief/tools/cc_statusline_snapshot.mjs)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git commit -a*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(npx supabase db pull*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
