# Flutter build & runtime artifacts
project/build/
/.vercel/
/.vercel-flutter/
project/.dart_tool/
project/.pub-cache/
project/.pub/
project/.flutter-plugins-dependencies
project/android/app/debug/
project/android/app/profile/
project/android/app/release/
project/ios/Flutter/.last_build_id

# System & OS artifacts
.DS_Store
Thumbs.db
*.log
*.tmp

# Node tooling (Supabase CLI, installed local-only via npm)
node_modules/

# Local dart-define values (real Supabase keys) — never commit, see dart_define.example.json
project/dart_define.local.json

# Credentials and Android signing material stay outside version control.
.env
.env.*
!.env.example
!*.example
supabase/.env
**/dart_define.local.json
*.jks
*.keystore
key.properties


# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
