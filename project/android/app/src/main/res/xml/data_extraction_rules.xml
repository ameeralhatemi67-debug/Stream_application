<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later (API 31+): nothing of this app is copied by cloud backup or by
  device-to-device transfer. See the comment on android:allowBackup in
  AndroidManifest.xml for why (Supabase session, device ID, Firebase registration).
  Syntax: https://developer.android.com/identity/data/autobackup (each rule needs a
  domain and a path; "." means the whole folder).
  Android 11 and earlier use android:allowBackup="false" alone, which turns backup off.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
