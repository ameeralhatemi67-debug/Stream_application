<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishing Readiness Audit, Phase 7 — replaces the previous blanket
  android:usesCleartextTraffic="true" (flagged as VULN-DATA-02, Critical, in
  doc/Audit/01_Security_Data_Protection_Audit.md).

  Default posture: cleartext (unencrypted HTTP) traffic is now DENIED for every
  domain. All of this app's real traffic already uses HTTPS (YouTube Data API,
  YouTube embeds, OpenStreetMap tile server), so this should require zero
  further changes for normal operation.

  Note on RTMP (updated 2026-11-11): RTMP is not HTTP. This file governs HTTP(S)
  made through Android's own network stack (HttpURLConnection, OkHttp, WebView). It
  does not govern the raw sockets RootEncoder opens for phone broadcasting
  (RtmpPublisherBridge). Phone broadcasts to YouTube use RTMPS (AppProvider checks
  for an rtmps:// YouTube ingest address). flutter_vlc_player is no longer a
  dependency. Don't loosen this config to "fix" an RTMP issue.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
