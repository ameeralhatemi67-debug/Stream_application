<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Deliberately identical to values/styles.xml. The app ships one light
      ThemeData (scheme A, ThemeMode.light), so a dark-mode device must not get
      a black launch window and window background: that produced a black splash
      followed by a flash to the white UI.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
