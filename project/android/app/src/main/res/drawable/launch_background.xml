<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch window: the gold mark on night slate (s900), the same in light and
  dark mode, matching the launcher tile.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_night" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
