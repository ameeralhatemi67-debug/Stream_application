<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- CAMERA permission removed (Publishing Readiness Audit, Phase 2/7): the app only ever
         calls image_picker with ImageSource.gallery, never ImageSource.camera — an unused
         declared permission is flagged by both Play Console and Apple's privacy review, and
         needlessly worries privacy-conscious users. Re-add only if/when a real "take photo"
         option is built (see doc/Audit/02_Permissions_Audit.md). -->
    <!-- READ_EXTERNAL_STORAGE and READ_MEDIA_IMAGES removed (P8A). image_picker is only ever
         called with ImageSource.gallery, and image_picker_android goes through the Android
         photo picker (ACTION_PICK_IMAGES / PickVisualMedia, with ACTION_GET_CONTENT below
         API 33). Both hand back a per-item URI grant and need no storage permission, and the
         plugin's own manifest declares none. Declaring them anyway asks every user for
         access to their whole photo library, which Play Console flags and which the app does
         not use. Re-add only if the app ever enumerates MediaStore directly. -->
    <!-- CAMERA + RECORD_AUDIO (v0.7 Checkpoint 2): captures the phone's own
         camera/mic to publish an RTMP broadcast, see
         doc/Roadmap/v0.7_Mobile_Streaming_Android.md. Runtime-permission
         rationale dialogs are shown contextually in-app (see
         PermissionRationaleDialog) before the OS prompt fires. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Keeps camera+mic capture alive through backgrounding/screen-lock
         while a phone broadcast is live (doc/Audit/02_Permissions_Audit.md's
         previously-unverified foreground-service gap). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- v0.7 Checkpoint 3 Phase 2: without this, RtmpForegroundService still
         runs correctly in the background (confirmed via device testing;
         Android only requires startForeground() to have been called, not
         that the user granted this), but its ongoing-broadcast notification
         is silently invisible on API 33+, which defeats the point of having
         one. Requested at runtime, best-effort, in PhoneBroadcastScreen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Foreground only: asked when the user picks a location ("use my location"). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Play review readiness 2026-11-11. CAMERA implies android.hardware.camera and
         android.hardware.camera.autofocus, and RECORD_AUDIO implies
         android.hardware.microphone, all as required. Google Play would then hide the
         app from tablets and other devices without a rear camera or a microphone, yet
         most people only watch. Only phone broadcasting needs them, so they are
         optional here. On a device without a rear camera, RearCameraSource throws and
         RtmpPublisherBridge answers ENCODER_FAILED (read from the code, not yet tried
         on such a device). -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- No Android backup (2026-11-11). Shared preferences hold the Supabase session
         (refresh token), this phone's device ID for the one-broadcaster rule, and
         Firebase's push registration. A restore on another phone would copy all three,
         which Android's backup guide says to exclude. allowBackup="false" stops cloud
         backup; data_extraction_rules.xml also stops device-to-device transfer, which
         allowBackup alone does not stop on Android 12 and later. -->
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Supabase Auth OAuth callback deep link (Google sign-in). Must match
                 SupabaseConfig.oauthRedirectUrl and be added to the Supabase project's
                 Authentication > URL Configuration > Redirect URLs allow-list. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="${oauthScheme}" android:host="login-callback"/>
            </intent-filter>
            <!-- Channel consent returns without Auth tokens; route to connections. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="${oauthScheme}" android:host="channel-connected"/>
            </intent-filter>
        </activity>
        <!-- Two launcher entries with the same (gold) icon. The app used to switch
             between them for the green and gold palettes, and Android keeps the
             component state an earlier version set across updates, so a device
             may have either one enabled. Removing either would hide the app on
             some devices. Never disable the actual activity. -->
        <activity-alias
            android:name="sa.hadayah.streamer_app.DefaultLauncher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="sa.hadayah.streamer_app.HidayahLauncher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Pushes that arrive while the app is closed: the mark in one colour
             (Android turns a full-colour icon into a blank shape), the brand
             gold, and the channel MainActivity creates. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_monochrome" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_gold" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/alerts_channel_id" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- v0.7 Checkpoint 2: foreground service backing the phone
             broadcast's camera+mic capture (see RtmpPublisherBridge /
             RtmpForegroundService). Only started while a broadcast is live. -->
        <service
            android:name=".streaming.RtmpForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
        <!-- The geolocator plugin declares a "location" foreground service for
             background position streams. The app never starts it: it reads one
             position with getCurrentPosition() when the user taps "use my location",
             with the app on screen. Removed (2026-11-11) so the merged manifest
             declares no location foreground service, which Play Console would
             otherwise ask about in its foreground-service form. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            tools:node="remove" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vnd.youtube" />
        </intent>
        <package android:name="com.google.android.youtube" />
    </queries>
</manifest>
