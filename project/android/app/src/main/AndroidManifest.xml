<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- CAMERA permission removed (Publishing Readiness Audit, Phase 2/7): the app only ever
         calls image_picker with ImageSource.gallery, never ImageSource.camera — an unused
         declared permission is flagged by both Play Console and Apple's privacy review, and
         needlessly worries privacy-conscious users. Re-add only if/when a real "take photo"
         option is built (see doc/Audit/02_Permissions_Audit.md). -->
    <!-- READ_EXTERNAL_STORAGE and READ_MEDIA_IMAGES removed (P8A). image_picker is only ever
         called with ImageSource.gallery, and image_picker_android goes through the Android
         photo picker (ACTION_PICK_IMAGES / PickVisualMedia, with ACTION_GET_CONTENT below
         API 33). Both hand back a per-item URI grant and need no storage permission, and the
         plugin's own manifest declares none. Declaring them anyway asks every user for
         access to their whole photo library, which Play Console flags and which the app does
         not use. Re-add only if the app ever enumerates MediaStore directly. -->
    <!-- CAMERA + RECORD_AUDIO (v0.7 Checkpoint 2): captures the phone's own
         camera/mic to publish an RTMP broadcast, see
         doc/Roadmap/v0.7_Mobile_Streaming_Android.md. Runtime-permission
         rationale dialogs are shown contextually in-app (see
         PermissionRationaleDialog) before the OS prompt fires. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Keeps camera+mic capture alive through backgrounding/screen-lock
         while a phone broadcast is live (doc/Audit/02_Permissions_Audit.md's
         previously-unverified foreground-service gap). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- v0.7 Checkpoint 3 Phase 2: without this, RtmpForegroundService still
         runs correctly in the background (confirmed via device testing;
         Android only requires startForeground() to have been called, not
         that the user granted this), but its ongoing-broadcast notification
         is silently invisible on API 33+, which defeats the point of having
         one. Requested at runtime, best-effort, in PhoneBroadcastScreen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase Auth OAuth callback deep link (Google sign-in). Must match
                 SupabaseConfig.oauthRedirectUrl and be added to the Supabase project's
                 Authentication > URL Configuration > Redirect URLs allow-list. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="sa.hadayah.streamerapp" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- v0.7 Checkpoint 2: foreground service backing the phone
             broadcast's camera+mic capture (see RtmpPublisherBridge /
             RtmpForegroundService). Only started while a broadcast is live. -->
        <service
            android:name=".streaming.RtmpForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vnd.youtube" />
        </intent>
        <package android:name="com.google.android.youtube" />
    </queries>
</manifest>
